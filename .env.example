# Copy to .env for local overrides. Do not commit .env.

# mock: deterministic local answers, no API key. openai: any OpenAI-compatible chat endpoint.
LLM_MODE=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Mock hashing embeddings are 64-dimensional. Match this to the provider when LLM_MODE=openai.
EMBEDDING_DIM=64

# memory: in-process graph (CI and the quickstart). neo4j: bolt store from compose.yaml.
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local development fallback only. Set a real secret outside the repository.
NEO4J_PASSWORD=

ERP_DATABASE_PATH=var/erp.sqlite
AGRITRACE_AS_OF=2026-11-13
AGRITRACE_ONTOLOGY=

# none | console | otlp
OTEL_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional LangSmith. Leave tracing off unless you intend to send prompts to LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agritrace

# 1 keeps the demo principal as a regulator when no actor header is sent.
# Set to 0 so the API requires X-Actor-Id and X-Actor-Role.
AGRITRACE_DEMO_OPEN=1
AUDIT_LOG_PATH=var/audit.jsonl
PORT=8000
